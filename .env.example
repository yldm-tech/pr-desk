DATABASE_URL="host=localhost user=prdashboard password=prdashboard dbname=prdashboard port=5432 sslmode=disable"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Embedded UI: same URL as API. For Vite development use its origin instead.
WEB_ORIGIN=http://localhost:8080

# Generate with: openssl rand -hex 16 (32 characters); required at API startup
TOKEN_ENCRYPTION_KEY=

PORT=8080
# Optional override; otherwise uses http://localhost:${PORT}/api/v1/auth/github/callback
GITHUB_REDIRECT_URL=
SYNC_MAX_PAGES=10

# GitHub App slug used for its installation link
GITHUB_APP_SLUG=
