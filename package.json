  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "bun": ">=1.3.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  }
}
